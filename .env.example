PORT=5000
MONGODB_URI=mongodb://localhost:27017/nice-aquarium-house
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Email notifications (order confirmation to the shop owner, status
# updates to customers) — optional. If any of these are missing, email
# sending is skipped and logged; it never blocks order creation or
# status updates. See README.md / AI_CONTINUATION_PROMPT.md for setup.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace-with-your-smtp-username
EMAIL_PASSWORD=replace-with-your-smtp-password-or-app-password
EMAIL_FROM=Nice Aquarium House <replace-with-your-smtp-username>
OWNER_EMAIL=replace-with-the-shop-owners-email
# Optional — real Google Business review link for the "Leave a Google
# Review" button on the Delivered email. Left blank, that email shows a
# placeholder note instead of a fake/guessed link.
GOOGLE_REVIEW_URL=
